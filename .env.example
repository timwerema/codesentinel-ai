APP_NAME="CodeSentinel AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=codesentinel
DB_USERNAME=codesentinel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------- CodeSentinel ----------------
# AI review. "auto" uses Claude when ANTHROPIC_API_KEY is set, otherwise a clearly labelled
# demo mode that calls no model. "demo" forces demo mode, "off" skips the AI step.
CODESENTINEL_AI=auto
# Server-side only. Never commit a real key and never expose it to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# US dollars per million tokens, used only for the cost estimate shown next to a review.
ANTHROPIC_PRICE_INPUT=4.00
ANTHROPIC_PRICE_OUTPUT=20.00
CODESENTINEL_AI_REVIEWS_PER_HOUR=10

# Upload limits
CODESENTINEL_MAX_FILES=10
CODESENTINEL_MAX_FILE_BYTES=204800
CODESENTINEL_MAX_TOTAL_BYTES=1048576
CODESENTINEL_ANALYSES_PER_HOUR=20

# Scanners (must be on the worker's PATH, or give full paths)
SEMGREP_BINARY=semgrep
GITLEAKS_BINARY=gitleaks
SCANNER_TIMEOUT=60
SCANNER_MEMORY_MB=2048

# Optional: fixed password for the demo account created by DemoSeeder
DEMO_PASSWORD=

# Send cookies over https only. Set to true in production.
SESSION_SECURE_COOKIE=false

